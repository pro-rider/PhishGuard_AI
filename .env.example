# ==============================================================================
# PhishGuard_AI - Environment Template
# Copy to .env and fill in real values. Never commit secrets.
# ==============================================================================

APP_NAME=PhishGuard_AI
APP_VERSION=14.0.0
ENVIRONMENT=development
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

HOST=0.0.0.0
PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000

POSTGRES_USER=phishguard
POSTGRES_PASSWORD=change-me
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=phishguard

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_WORKER_CONCURRENCY=4

S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=phishguard
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

LOG_LEVEL=INFO
ENABLE_PII_REDACTION=true
SERVICE_NAME=api-gateway

PHISHGUARD_MODEL_SIGNING_KEY=